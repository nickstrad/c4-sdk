{
  "name": "c4-sdk",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --ignore-pattern dist-sdk --ignore-pattern .sdk-types",
    "preview": "vite preview",
    "dev:demo": "vite --config demos/git-at-any-scale/vite.config.ts",
    "build:demo": "tsc -b && vite build --config demos/git-at-any-scale/vite.config.ts",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit --project hooks",
    "test:prop": "vitest run --project property",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:prop && npm run build && npm run build:demo && npm run test:browser",
    "sdk:build": "node sdk-build.mjs",
    "sdk:check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:prop && npm run test:api",
    "test:api": "vitest run --config tests/package/api.config.ts",
    "test:package": "node tests/package/verify.mjs",
    "test:package:browser": "playwright test --config tests/package/playwright.config.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "^4.0.3",
    "elkjs": "0.12.0",
    "fast-check": "^4.10.2",
    "lucide-react": "^1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.4",
    "rolldown": "1.2.14",
    "rolldown-plugin-dts": "0.28.8",
    "postcss": "8.5.29"
  },
  "description": "Accessible React viewers and browser-free data tools for all seven C4 architecture diagram types",
  "license": "MIT",
  "author": "Nick Strad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickstrad/c4-sdk.git"
  },
  "homepage": "https://nickstrad.github.io/c4-sdk/",
  "bugs": {
    "url": "https://github.com/nickstrad/c4-sdk/issues"
  },
  "keywords": [
    "c4",
    "architecture",
    "diagrams",
    "react"
  ],
  "engines": {
    "node": "22.23.2"
  },
  "files": [
    "dist-sdk",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-sdk/index.cjs",
  "module": "./dist-sdk/index.mjs",
  "types": "./dist-sdk/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-sdk/index.d.mts",
        "default": "./dist-sdk/index.mjs"
      },
      "require": {
        "types": "./dist-sdk/index.d.cts",
        "default": "./dist-sdk/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist-sdk/core.d.mts",
        "default": "./dist-sdk/core.mjs"
      },
      "require": {
        "types": "./dist-sdk/core.d.cts",
        "default": "./dist-sdk/core.cjs"
      }
    },
    "./styles.css": "./dist-sdk/styles.css",
    "./layout-worker.js": "./dist-sdk/layout-worker.js"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
