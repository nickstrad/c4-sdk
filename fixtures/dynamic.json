  "documents": [
    {
      "id": "overview",
      "title": "An external view",
      "plain": "This small context interprets the article\u2019s system boundaries. It omits internal storage and replication details.",
      "ste": {
        "text": "This diagram shows the system and its users. It does not show internal parts.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "user-doc",
      "title": "Git user",
      "plain": "Developers use Git operations to exchange repository changes. The person is a context abstraction.",
      "ste": {
        "text": "The developer sends and receives repository changes.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "system-doc",
      "title": "Continuity",
      "plain": "Cursor describes Continuity as a Git storage system. Its write-ahead log is the source of truth.",
      "ste": {
        "text": "Continuity stores repository changes in a write-ahead log.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "storage-doc",
      "title": "Object storage",
      "plain": "The article identifies S3 as the production object store. The context shows this as an external dependency.",
      "ste": {
        "text": "The object store holds the write-ahead log.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "container-overview",
      "title": "Logical container view",
      "plain": "This is an inferred C4 decomposition of the article\u2019s responsibilities. A logical Continuity server uses a local Git repository and the external S3 WAL. It does not claim separate deployable services, host counts, or a production topology.",
      "ste": {
        "text": "This view shows logical parts. The server uses a local Git repository and S3 storage. The boundaries are inferred.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "server-doc",
      "title": "Continuity server (inferred boundary)",
      "plain": "The article describes servers preparing reference transactions and accessing the WAL. This diagram groups those responsibilities into one inferred application container.",
      "ste": {
        "text": "The server prepares reference transactions and uses the WAL. This application boundary is inferred.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "repository-doc",
      "title": "Local Git repository",
      "plain": "The article describes a normal Git repository on NVMe as a warm cache. The datastore container is a logical abstraction; the article does not describe it as a separate service.",
      "ste": {
        "text": "The local Git repository acts as a cache. The datastore boundary is inferred.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "article"
      ]
    },
    {
      "id": "replica-role",
      "title": "Replica role (inferred)",
      "plain": "This logical role checks freshness before serving. Gossip helps catch-up; it is not a correctness requirement.",
      "ste": {
        "text": "Check freshness before you serve a read. Gossip helps the replica.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "replication"
      ]
    },
    {
      "id": "push-doc",
      "title": "Push: durable publication",
      "plain": "Original abstraction: WAL persistence and local preparation precede CAS publication. Branches keep independent order; boundaries are inferred.",
      "ste": {
        "text": "Store the WAL entry. Prepare the references. Publish the index. Then acknowledge the push.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "consensus"
      ]
    },
    {
      "id": "read-current-doc",
      "title": "Read: freshness already matches",
      "plain": "A conditional freshness check guards serving. This successful 304 path is separate from catch-up.",
      "ste": {
        "text": "Check freshness. If the index is unchanged, serve the read.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "replication"
      ]
    },
    {
      "id": "read-catch-up-doc",
      "title": "Read: catch up before serving",
      "plain": "The 200 path receives the new index and catches up before serving. It does not depend on gossip delivery.",
      "ste": {
        "text": "Get the new index. Get missing data. Catch up before you serve the read.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "replication"
      ]
    },
    {
      "id": "compaction-doc",
      "title": "Compaction: reuse compacted packs",
      "plain": "Only the primary compacts; replicas follow the WAL and reuse the result. Role boundaries are inferred.",
      "ste": {
        "text": "The primary compacts the data. The replica gets the compacted packs.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "compaction"
      ]
    },
    {
      "id": "gossip-doc",
      "title": "Gossip: optional catch-up notification",
      "plain": "Gossip accelerates catch-up. Lost notifications do not remove conditional freshness checks on read paths.",
      "ste": {
        "text": "Gossip helps catch-up. A read still needs a freshness check.",
        "issue": "ASD-STE100 Issue 9",
        "reviewStatus": "draft"
      },
      "sourceIds": [
        "replication"
      ]
    }
  ],
